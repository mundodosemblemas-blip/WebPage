# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co

# Public key. Safe in the browser: RLS lets it read active products only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# SECRET. Bypasses Row Level Security — server-side only, never NEXT_PUBLIC_.
# Every order read/write and every catalog write runs under this key.
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# --- Admin ------------------------------------------------------------------
# Password for /admin. Also signs the admin session cookie, so changing it
# immediately logs out every existing admin session.
ADMIN_PASSWORD=<a long random password>

# --- Order emails (Gmail SMTP with an app password) -------------------------
# Optional: with these unset the app still works, it just sends no email.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=<16-char app password>
ADMIN_NOTIFY_EMAIL=you@gmail.com

# --- Site -------------------------------------------------------------------
# Used for canonical URLs, the sitemap, and the order links in emails.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://web-page-two-green.vercel.app
